# =============================================================================
# ModelMedic — .env.example
# Copy to .env and fill in values. NEVER commit .env.
# =============================================================================

# ── ClearML Server (required) ─────────────────────────────────────────────────
# ModelMedic reads from ~/clearml.conf by default (set up via clearml-init).
# You can override individual values here if needed:
# CLEARML_API_HOST=https://api.clear.ml
# CLEARML_WEB_HOST=https://app.clear.ml
# CLEARML_FILES_HOST=https://files.clear.ml
# CLEARML_API_ACCESS_KEY=your-access-key
# CLEARML_API_SECRET_KEY=your-secret-key

# ── LLM Provider (required for Copilot & AI explanations) ─────────────────────
# Choose one or both. ModelMedic uses Gemini by default.
MODELMEDIC_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# ── ModelMedic API Server ──────────────────────────────────────────────────────
MODELMEDIC_API_HOST=localhost
MODELMEDIC_API_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local development (default):
MODELMEDIC_DB_URL=sqlite:///./modelmedic.db
# PostgreSQL for production:
# MODELMEDIC_DB_URL=postgresql://user:password@localhost:5432/modelmedic

# ── ChromaDB (vector store for RAG) ──────────────────────────────────────────
MODELMEDIC_CHROMA_PATH=./chroma_db

# ── Encoding ──────────────────────────────────────────────────────────────────
PYTHONIOENCODING=utf-8
